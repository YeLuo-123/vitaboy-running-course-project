[Unit]
Description=X5 HTTP mapping and navigation console
After=network.target

[Service]
Type=simple
User=wheeltec
Group=wheeltec
WorkingDirectory=/home/wheeltec/x5_http_console
ExecStart=/home/wheeltec/x5_http_console/run.sh
Restart=on-failure
RestartSec=3
KillMode=mixed
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
